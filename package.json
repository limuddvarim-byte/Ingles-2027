{
  "name": "ingles",
  "productName": "Inglês",
  "version": "1.0.0",
  "description": "Inglês — sua tríade de estudos (software, app e extensão)",
  "author": "Inglês",
  "private": true,
  "main": "electron-dist/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build:web": "vite build --mode web",
    "build:desktop-ui": "vite build --mode desktop",
    "build:android-ui": "vite build --mode android",
    "build:extension": "node scripts/build-extension.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:icons": "node scripts/make-icons.mjs",
    "dist:win": "npm run build:desktop-ui && npm run build:extension && npm run build:electron && electron-builder --win nsis --publish never",
    "android:sync": "npm run build:android-ui && npx cap sync android",
    "electron": "npm run build:desktop-ui && npm run build:electron && electron ."
  },
